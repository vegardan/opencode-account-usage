{
  "name": "opencode-account-usage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-account OpenAI usage dashboard for OpenCode Desktop",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "install:local": "node scripts/install.mjs",
    "dev": "vite --config dev/vite.config.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsonc-parser": "^3.3.1",
    "solid-js": "^1.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
